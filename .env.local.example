# Copy to .env.local and fill what you have. Everything has a safe fallback.
# The app works end-to-end even with NONE of these set (uses seeded demo data).

# --- Agent brain (most important for LIVE analysis of a new bakery) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Supabase (persistence + realtime). Falls back to in-memory store. ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (pre-order checkout from poster QR). Test mode. ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Firecrawl (live Google Maps popular-times scrape). Falls back to seed. ---
FIRECRAWL_API_KEY=

# --- Freestyle (deploy generated bakery website). ---
FREESTYLE_API_KEY=

# --- Canva / ElevenLabs (poster + tiktok assets). ---
CANVA_API_TOKEN=
ELEVENLABS_API_KEY=

# --- Omnara (agent run monitoring). ---
OMNARA_API_KEY=
