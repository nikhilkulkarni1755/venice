# Copy to .env.local and fill what you have. Everything has a safe fallback.
# Without these, new bakeries can't be ingested (there is no demo/seed data).

# --- Agent brain (most important for LIVE analysis of a new bakery) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Supabase (persistence + realtime). Falls back to in-memory store. ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (pre-order checkout from poster QR). Test mode. ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Context.dev: live Google Maps listing, business site, menu (server-only). ---
CONTEXT_DEV_API_KEY=

# --- Popular times (hourly busyness): BestTime first, then Apify. Unavailable if neither. ---
BESTTIME_API_KEY_PRIVATE=
APIFY_TOKEN=

# --- OpenAI: AI dish images on the poster (optional; plain dish cards without it). ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# --- Freestyle (deploy generated bakery website). ---
FREESTYLE_API_KEY=

# --- Canva / ElevenLabs (poster + tiktok assets). ---
CANVA_API_TOKEN=
ELEVENLABS_API_KEY=

# --- Omnara (agent run monitoring). ---
OMNARA_API_KEY=
